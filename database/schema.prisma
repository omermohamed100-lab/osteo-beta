generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  role           String   @default("admin")
  isActive       Boolean  @default(true)
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RateLimitBucket {
  id          String   @id
  scope       String
  keyHash     String
  windowStart DateTime
  expiresAt   DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
  @@index([scope, keyHash])
}

model Course {
  id          String    @id @default(cuid())
  title       String
  titleAr     String    @default("")
  description String
  descriptionAr String  @default("")
  instructor  String
  instructorAr String   @default("")
  duration    String
  durationAr  String    @default("")
  startDate   DateTime
  endDate     DateTime?
  price       Float?
  priceCurrency String @default("")
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CourseInterest {
  id                          String   @id @default(cuid())
  email                       String
  topic                       String   @default("")
  consentNotifications        Boolean
  notificationStatus          String   @default("pending")
  notificationAttempts        Int      @default(0)
  notificationLastAttemptedAt DateTime?
  notificationSentAt          DateTime?
  createdAt                   DateTime @default(now())
  dedupeReservation           CourseInterestDedupe?

  @@index([createdAt])
  @@index([createdAt, id])
  @@index([email, createdAt])
}

model ContactSubmission {
  id                          String                   @id @default(cuid())
  name                        String
  email                       String
  subject                     String
  message                     String
  notificationStatus          String                   @default("pending")
  notificationAttempts        Int                      @default(0)
  notificationLastAttemptedAt DateTime?
  notificationSentAt          DateTime?
  createdAt                   DateTime                 @default(now())
  dedupeReservation           ContactSubmissionDedupe?

  @@index([createdAt, id])
}

model ContactSubmissionDedupe {
  keyHash      String            @id
  submissionId String            @unique
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model SiteSettings {
  id                      String @id @default("global")
  phone                   String @default("")
  email                   String @default("support@eg-som.com")
  address                 String @default("")
  addressAr               String @default("")
  facebook                String @default("")
  instagram               String @default("")
  linkedin                String @default("")
  youtube                 String @default("")
  x                       String @default("")
  whatsapp                String @default("")
  facebookEnabled         Boolean @default(true)
  youtubeEnabled          Boolean @default(true)
  linkedinEnabled         Boolean @default(true)
  xEnabled                Boolean @default(true)
  whatsappEnabled         Boolean @default(true)
  facebookOrder           Int @default(0)
  youtubeOrder            Int @default(1)
  linkedinOrder           Int @default(2)
  xOrder                  Int @default(3)
  whatsappOrder           Int @default(4)
  heroEyebrow             String @default("EGYPTIAN SOCIETY OF OSTEOPATHIC MEDICINE")
  heroEyebrowAr           String @default("الجمعية المصرية لطب الأوستيوباثي")
  heroHeadline            String @default("Find an osteopath. Explore training in Egypt.")
  heroHeadlineAr          String @default("ابحث عن ممارس أوستيوباثي. واستكشف التدريب في مصر.")
  heroDescription         String @default("EGSOM advances awareness, education, and professional osteopathic practice in Egypt, supporting practitioners across Egypt and the Middle East through training, knowledge exchange, and international partnerships.")
  heroDescriptionAr       String @default("تعمل الجمعية المصرية لطب الأوستيوباثي على نشر الوعي بالأوستيوباثي ودعم تعليمه وممارسته المهنية في مصر والشرق الأوسط، عبر التدريب وتبادل الخبرات والشراكات الدولية.")
  heroPrimaryLabel        String @default("About")
  heroPrimaryLabelAr      String @default("من نحن")
  heroPrimaryHref         String @default("/about")
  heroSecondaryLabel      String @default("Find an Osteopath")
  heroSecondaryLabelAr    String @default("ابحث عن أخصائي أوستيوباثي")
  heroSecondaryHref       String @default("/find-osteopath")
}

model BoardMember {
  id             String   @id @default(cuid())
  name            String
  nameAr          String
  position        String
  positionAr      String
  biography       String   @default("")
  biographyAr     String   @default("")
  email           String   @default("")
  linkedin        String   @default("")
  sortOrder       Int      @default(0)
  isPublished     Boolean  @default(false)
  photoData       Bytes?
  photoMediaType  String   @default("")
  photoUpdatedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model Osteopath {
  id           String   @id @default(cuid())
  name         String
  nameAr       String   @default("")
  specialty    String
  specialtyAr  String   @default("")
  city         String
  cityAr       String   @default("")
  country      String   @default("Egypt")
  countryAr    String   @default("")
  location     String   @default("")
  locationAr   String   @default("")
  phone        String   @default("")
  email        String   @default("")
  bio          String   @default("")
  bioAr        String   @default("")
  profileImage String?
  credentialType       String   @default("")
  credentialTypeAr     String   @default("")
  credentialNumber     String   @default("")
  credentialIssuer     String   @default("")
  credentialIssuerAr   String   @default("")
  credentialStatus     String   @default("unverified")
  credentialVerifiedAt DateTime?
  credentialExpiresAt  DateTime?
  profileReviewedAt    DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sourceApplication PractitionerApplication?
}

model PractitionerApplication {
  id                    String    @id @default(cuid())
  applicationType       String
  status                String    @default("pending")
  name                  String
  nameAr                String    @default("")
  email                 String
  phone                 String
  specialty             String
  specialtyAr           String    @default("")
  city                  String
  cityAr                String    @default("")
  country               String    @default("Egypt")
  countryAr             String    @default("")
  location              String    @default("")
  locationAr            String    @default("")
  bio                   String
  bioAr                 String    @default("")
  profileImage          String?
  primaryLanguage       String    @default("en")
  photoData             Bytes?
  photoMediaType        String    @default("")
  photoOriginalName     String    @default("")
  credentialType        String
  credentialTypeAr      String    @default("")
  credentialNumber      String
  credentialIssuer      String
  credentialIssuerAr    String    @default("")
  credentialIssuedAt    DateTime?
  credentialExpiresAt   DateTime?
  existingProfileUrl    String    @default("")
  applicantNotes        String    @default("")
  consentAccuracy       Boolean
  consentPrivacy        Boolean
  reviewNotes           String    @default("")
  reviewedAt             DateTime?
  draftOsteopathId      String?   @unique
  draftOsteopath        Osteopath? @relation(fields: [draftOsteopathId], references: [id], onDelete: SetNull)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  dedupeReservation     PractitionerApplicationDedupe?

  @@index([status, createdAt])
  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@index([email, createdAt])
}

model CourseInterestDedupe {
  keyHash    String @id
  interestId String @unique
  expiresAt  DateTime
  interest   CourseInterest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PractitionerApplicationDedupe {
  keyHash       String @id
  applicationId String @unique
  expiresAt     DateTime
  application   PractitionerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model GalleryItem {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String   @default("")
  captionAr String   @default("")
  category  String   @default("General")
  categoryAr String  @default("")
  createdAt DateTime @default(now())
}

model Activity {
  id          String   @id @default(cuid())
  title       String
  titleAr     String   @default("")
  description String
  descriptionAr String @default("")
  date        DateTime
  location    String
  locationAr  String   @default("")
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PublicStatistic {
  id             String   @id @default(cuid())
  value          String
  label          String
  labelAr        String
  sourceLabel    String
  sourceUrl      String?
  lastVerifiedAt DateTime
  isPublished    Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, sortOrder])
}
