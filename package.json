{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "build:vercel": "node scripts/deploy-migrations.mjs && npm run build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./tests/tsx-windows-shim.cjs --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:auth": "tsx --test tests/auth.test.ts tests/auth-contract.test.ts",
    "test:public-data": "tsx --test tests/public-data.test.ts",
    "test:seo": "node --require ./tests/tsx-windows-shim.cjs --import tsx --test tests/seo-localization.test.ts",
    "test:trust": "node --require ./tests/tsx-windows-shim.cjs --import tsx --test tests/trust-content.test.ts",
    "test:security": "node --require ./tests/tsx-windows-shim.cjs --import tsx --test tests/auth.test.ts tests/auth-contract.test.ts tests/contact-security.test.ts tests/email.test.ts tests/public-data.test.ts tests/rate-limit.test.ts tests/request-security.test.ts tests/url-security.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@remotion/player": "4.0.499",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "next": "16.3.1",
    "nodemailer": "9.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "^4.0.499",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.499",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "prisma": {
    "schema": "database/schema.prisma",
    "seed": "npx tsx database/seed.ts"
  }
}
